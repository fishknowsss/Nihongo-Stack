{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nihongo Stack",
  "version": "0.7.0",
  "identifier": "com.nihongostack.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nihongo Stack",
        "width": 1380,
        "height": 900,
        "minWidth": 900,
        "minHeight": 680,
        "backgroundColor": "#f7f6f2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
